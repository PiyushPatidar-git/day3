#include<iostream>
using namespace std;

class sum{
    public:

    void add(int a, int b){
        cout<<a+b<<endl;
        return;
    }
    void add(int a, int b, int c){
        cout<<a+b+c<<endl;
         return;
    }
    void add(int a, int b, double c){
        cout<<a+b+c<<endl;
         return;
    }
    void add(int a, double b, double c){
        cout<<a+b+c<<endl;
         return;
    }
};
int main(){
    sum a;
    a.add(5,2);
    a.add(2,5,2);
    a.add(2,85,2.1);
    a.add(2,8.2,2.1);
    return 0;
}
